# Copie este arquivo para .env (local) ou cadastre as variáveis na Vercel
# (Project → Settings → Environment Variables). Nunca coloque valores reais neste arquivo.

# Token de acesso do Mercado Pago. Use o de TESTE até tudo estar validado.
MP_ACCESS_TOKEN=

# "test" enquanto usar as credenciais de teste (no painel novo elas também começam com APP_USR-).
# Apague ou deixe "production" ao trocar para as credenciais reais.
MP_ENV=test

# Chave secreta das notificações (Mercado Pago → Suas integrações → Webhooks). Opcional, mas recomendada.
MP_WEBHOOK_SECRET=

# Texto longo e aleatório usado para assinar os links de download (ex.: gerado por um gerenciador de senhas).
DOWNLOAD_SECRET=

# Por quantos dias o link de download vale.
DOWNLOAD_DAYS=7

# Endereço público do site, sem barra no final (na Vercel pode ficar vazio que é detectado).
SITE_URL=

# Onde cada PDF está guardado, em endereço privado. Formato JSON numa linha:
# {"temperos":"https://...","industrializados":"https://...","doces-fitness":"https://...","rotulos":"https://...","bebidas":"https://...","doces":"https://...","salada":"https://...","refeicao-livre":"https://..."}
GUIDE_FILES={}

# E-mail com os links (opcional). Conta em resend.com com o domínio verificado.
RESEND_API_KEY=
EMAIL_FROM=Nutrition's Life <guias@nutritionslife.com.br>
